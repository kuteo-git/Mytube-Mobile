<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Mytube</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!--
	  Audio has to keep playing with the screen locked. This is the whole reason
	  the app exists: the server charter's risk 4 says a native app is the only
	  path to background playback on iOS, and without this key the sound stops
	  the moment the screen locks no matter what the audio session says.

	  It is the pair of AVAudioSessionCategoryPlayback in AvVideoPlayer. Either
	  one alone is silence.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!--
	  The library is reached by IP over plain HTTP. The gateway has no TLS and
	  the charter leaves media URLs unprotected on the reasoning that the LAN is
	  trusted, so App Transport Security has to be told — deliberately, and only
	  for that reason.

	  NSAllowsLocalNetworking rather than NSAllowsArbitraryLoads: it permits
	  cleartext to local addresses and to .local names, and refuses it to the
	  internet. Turning the whole of ATS off would allow both.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!--
	  iOS 14 and later ask before an app may talk to devices on the same wifi,
	  and this string is what the prompt says. Without it the app is refused the
	  network with no error a user could act on.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Mytube plays videos from the library on your home network.</string>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!--
	  Portrait only, to match the Android side. The activity there declares
	  configChanges for rotation, which is what makes holding the watch
	  ViewModel in `remember` correct; letting iOS rotate would be the two
	  platforms behaving differently for no gain, in the one place that costs a
	  restarted video.
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
