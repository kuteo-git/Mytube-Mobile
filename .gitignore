# Build outputs
build/
*/build/
.gradle/
local.properties

# The toolchain lives on Data2 and is named by env.sh; nothing about it belongs
# in the repository.
.kotlin/

# Xcode
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
DerivedData/

.DS_Store

# Built APKs. They are large, and a fresh one is one command away.
dist/

# JVM crash dumps — a Kotlin/Native compile can leave these in the project root.
hs_err_pid*.log
replay_pid*.log

# The release key. See keystore.properties for why it is not here.
keystore.properties
*.jks

# The phones tools/ios-device-install.sh signs for. UDIDs are the household's.
ios-devices

# Source, whatever a global ignore says. A `model` line in a developer's
# ~/.gitignore_global kept nine of domain/model's ten files out of every
# commit, and a fresh clone did not compile (found 2026-11-01).
!composeApp/src/commonMain/kotlin/com/mytube/app/domain/model/
!composeApp/src/commonMain/kotlin/com/mytube/app/domain/model/**
