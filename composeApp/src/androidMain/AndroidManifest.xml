<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The library lives on the house wifi and is reached by IP over plain
         HTTP: the gateway has no TLS, and the charter leaves media URLs
         unprotected on the reasoning that the LAN is trusted. Android blocks
         cleartext by default, so it has to be allowed - deliberately, and only
         for that reason. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Audio has to keep playing with the screen off. That is the whole point
         of this app existing: risk 4 in the charter says a native app is the
         only path to background playback on iOS, and Android needs the service
         type declared to do the same. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
      Android 13 and later suppress the media notification without this, and the
      notification is not decoration: it is the lock-screen controls and the only
      way to pause without opening the app. Playback still works — which is what
      makes the omission easy to miss, since everything sounds right.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      One APK for the phone and the television. Declared not-required, both of
      them: a television has no touchscreen, and Android assumes one unless told
      otherwise, so without the first line the TV's store and its sideloading
      checks treat this as a phone-only app. The second says the TV launcher is
      welcome rather than demanded, so phones keep installing it.
    -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!--
      Voice search on the television asks whether a speech recogniser exists
      before it draws a microphone. From Android 11 another app's activities
      are invisible to that question unless the kind is declared here, and the
      answer would always be "none".
    -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:label="Mytube"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/tv_banner"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mytube">
        <!--
          singleTask: one activity, one sitting. Opened again from a launcher
          whose intent did not match the task's, Android stacked a second
          MainActivity on the first - measured on the household's Chromecast -
          and each held its own player and narrator over the one shared video:
          two voices, and the switch silenced only one. ManifestGuardTest holds
          this line.
        -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- What puts the app on a television's home screen. A phone's
                     launcher ignores it. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The player lives here so the sound survives the screen going off.
          foregroundServiceType is not optional: without it the system refuses
          to promote the service and kills it the moment the app is
          backgrounded, which is precisely the case this app exists for.
        -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
